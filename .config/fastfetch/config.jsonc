      "type": "custom", // InformationEnd
      "format": "{#32}└────────────────────────────┘{#}"
    },
    "break",
    {
      "type": "colors",
      "key": " ",
      "keyIcon": "",
      "symbol": "diamond",
      "paddingLeft": 0,
      "block": {
        "width": 7,
        "range": [
          0,
          15
        ]
      }
    }
