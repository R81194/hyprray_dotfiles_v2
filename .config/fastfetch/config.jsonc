    //   "key": " "
    // },
    {
      "type": "terminal",
      "key": "├  "
    },
    {
      "type": "packages",
      "key": "├ 󰏖 ",
      "disabled": [
        "apk"
      ],
      "combined": false
    },
    {
      "type": "command",
      "key": "├ 󰆧 ",
      "text": "printf '%s (yay)' $(pacman -Qm | wc -l)"
    },
    {
      "type": "shell",
      "key": "├  "
    },
