/******--- Glassy Pywal Now Playing Menu ---*****/

/* Import Pywal colors generated by your scripts */
@import "~/.cache/wal/colors.rasi"

configuration {
    show-icons:                  false;
}

* {
    /* Glassy Palette matching your wallpaper dock */
    background-glass:     #00000080; /* 50% transparent dark glass for main window */
    background-alt-glass: #ffffff1A; /* 10% transparent white for inner boxes/buttons */
    selected-glass:       #ffffff26; /* 15% transparent white for hovered buttons */
    
    background-color:     transparent;
    text-color:           @foreground; /* Native Pywal text color */
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    southeast;
    anchor:                      center;
    fullscreen:                  false;   
    width:                       500px;
    height:                      360px;
    x-offset:                    -20px;   /* Adjusted to float slightly off the right edge */
    y-offset:                    -20px;   /* Adjusted to float slightly off the bottom edge */
    enabled:                     true;
    cursor:                      "default";
    
    background-color:            @background-glass;
    border:                      2px;
    border-color:                @color2; /* Dynamic Pywal window border */
    border-radius:               24px;    /* Matched the pill-like radius of the dock */
    padding:                     20px;
}

mainbox {
    enabled:                     true;
    spacing:                     20px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "top-message", "middle-wrapper", "listview" ];
}

/*****----- Header -----*****/
top-message {
    enabled:                     true;
    padding:                     0px;
    background-color:            transparent;
    children:                    [ "textbox-msg" ];
    expand:                      false;
}

textbox-msg {
    expand:                      true;
    background-color:            @background-alt-glass;
    text-color:                  @foreground;
    horizontal-align:            0.5;
    vertical-align:              0.5;
    str:                         "  Now Playing"; 
    font:                        "JetBrains Mono Bold 16";
    border-radius:               12px;
    border:                      1px;
    border-color:                @color3; /* Subtle Pywal border */
    padding:                     8px;
}

/*****----- Album Art & Song Info -----*****/
middle-wrapper {
    enabled:                     true;
    orientation:                 horizontal;
    spacing:                     20px;
    background-color:            transparent;
    expand:                      true; 
    children:                    [ "album-art", "custom-text-box" ];
}

album-art {
    enabled:                     true;
    width:                       170px; 
    height:                      170px; 
    background-color:            @background-alt-glass;
    background-image:            url("~/.config/scripts/nowplaying/album_art.jpg", height); 
    border-radius:               14px;
    border:                      1px;
    border-color:                @color4; /* Pywal border around the album art */
    expand:                      true; 
}

custom-text-box {
    enabled:                     true;
    expand:                      true;
    padding:                     20px;
    background-color:            @background-alt-glass;
    border-radius:               14px;
    border:                      1px;
    border-color:                @color4; /* Pywal border around text box */
    children:                    [ "textbox-custom" ];
}

textbox-custom {
    background-color:            transparent;
    text-color:                  @foreground;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    markup:                      true; 
    font:                        "JetBrains Mono Bold 14";
    str:                         "Loading...";
}

/*****----- Media Control Buttons -----*****/
listview {
    enabled:                     true;
    columns:                     3;
    lines:                       1;
    dynamic:                     true;
    reverse:                     false;    
    spacing:                     15px;
    background-color:            transparent;
    cursor:                      "default";
    expand:                      false; 
}

element {
    enabled:                     true;
    padding:                     15px;
    border-radius:               100%;    /* Keeps the circular button look */
    cursor:                      pointer;
    background-color:            @background-alt-glass;
    text-color:                  @foreground;
    orientation:                 horizontal;
    border:                      1px;
    border-color:                transparent;
}

element selected {
    background-color:            @selected-glass;
    border:                      2px;
    border-color:                @color5; /* Pywal Accent pops when hovering over a button */
    text-color:                  @color6;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    font:                        "JetBrains Mono 14";
}