/*******************************************************************************
 * ROFI GLASSY THEME (Vertical Right Sidebar) - Pywal Edition
 *******************************************************************************/

/* Import Pywal colors generated by your scripts */
@import "~/.cache/wal/colors.rasi"

configuration {
    mode: "drun,run,filebrowser,window";
    show-icons: true;
    display-drun: "";
    display-run: "";
    display-filebrowser: "";
    display-window: "";
    drun-display-format: "{name}";
    window-format: "{w} · {c} · {t}";
    click-to-exit: true;
}

* {
    font: "JetBrains Mono Nerd Font Propo 12"; 

    /* GLASSY PYWAL PALETTE */
    
    /* 1. Deep Dark Glass (Mostly Black for the base) */
    bg-glass: #000000A6; /* 65% transparent black */
    
    /* 2. Slightly Darker Glass (For Results List) */
    bg-dark: #000000B3;  /* 70% transparent black */

    /* Highlights (Increased the white visibility as requested) */
    glass-white:    #ffffff26; /* 15% transparent white (Search box) */
    glass-selected: #ffffff33; /* 20% transparent white (Hovered items) */
    
    /* Text Colors */
    fg-col:       @foreground; /* Native Pywal text color */
    fg-col-muted: #ffffff99;   /* 60% white for unselected text/placeholders */
    
    /* Inner Borders (Slightly brighter white for definition) */
    border-col:   #ffffff26; 
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height:           390px;
    width:            640px; 
    border:           4px;
    border-color:     @color2; /* Dynamic Pywal Accent Border */
    border-radius:    14px;
    background-color: transparent; /* Let the inner boxes handle the glass */
    transparency:     "real";
}

/* MAIN CONTAINER: Split Left (Content) and Right (Buttons) */
mainbox {
    background-color: transparent;
    orientation:      horizontal; 
    children:         [ left-box, mode-switcher ];
    spacing:          2px;
    padding:          0px;
    border-radius:    12px;
}

/* LEFT SIDE: Holds Search Bar + List */
left-box {
    orientation:      vertical;
    children:         [ inputbar, listview ];
    background-color: transparent;
    spacing:          2px;
    expand:           true;
    border:           1px;
    border-radius:    10px;
    border-color:     transparent;
}

/* RIGHT SIDE: Vertical Mode Buttons */
mode-switcher {
    orientation:      vertical; 
    background-color: @bg-glass; 
    border:           0px;
    border-color:     transparent;
    border-radius:    10px;
    padding:          6px;
    spacing:          5px;
    width:            66px; 
}

/* --- SEARCH BAR --- */
inputbar {
    children:         [ prompt, entry ];
    background-color: @bg-glass;
    border-radius:    10px;
    padding:          10px;
    border:           0px;
    border-color:     transparent;
}

prompt {
    background-color: @glass-white;
    padding:          6px 12px;
    text-color:       @fg-col;
    border-radius:    6px;
    margin:           0px 10px 0px 0px;
}

entry {
    padding:          6px;
    text-color:       white;
    background-color: transparent;
    placeholder:      "Search...";
    placeholder-color:@fg-col-muted;
}

/* --- LIST VIEW --- */
listview {
    background-color: @bg-dark; 
    columns:          2;
    lines:            6;
    border:           1px;
    border-color:     transparent;
    border-radius:    10px;
    padding:          10px;
    spacing:          5px;
}

element {
    padding:          8px;
    background-color: transparent;
    text-color:       @fg-col-muted;
    border-radius:    6px;
}

element-icon {
    size:             24px;
    margin:           0 10px 0 0;
}

element selected {
    background-color: @glass-selected;
    text-color:       @fg-col;
    border:           1px;
    border-color:     @color4; /* Tiny Pywal accent on the selected item */
}

/* --- BUTTONS STYLING --- */
button {
    padding:          10px;
    background-color: transparent;
    text-color:       @fg-col-muted;
    border-radius:    8px;
    cursor:           pointer;
}

button selected {
    background-color: @glass-selected; 
    text-color:       @fg-col;
    border:           1px;
    border-color:     @color5; /* Tiny Pywal accent on the active sidebar tab */
}