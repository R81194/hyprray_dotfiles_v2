/******--- Glassy Pywal Side/Power Menu ---*****/

/* Import Pywal colors generated by your scripts */
@import "~/.cache/wal/colors.rasi"

configuration {
    show-icons: false;
    click-to-exit: true;
}

* {
    /* Glassy Palette matching your setup */
    background-glass:     #00000080; /* 50% transparent dark glass */
    background-alt-glass: #ffffff1A; /* 10% transparent white for resting buttons */
    selected-glass:       #ffffff26; /* 15% transparent white for hovered buttons */
    
    background-color:     transparent;
    text-color:           @foreground; /* Native Pywal text color */
    font:                 "JetBrainsMono Nerd Font Propo 20";
}

window {
    transparency:         "real";
    location:             east;
    anchor:               east;
    width:                100px;
    height:               0px;
    
    /* Untouched Offsets */
    x-offset:             -20px;
    y-offset:             0px;
    
    /* Glassy Window Styling */
    background-color:     @background-glass;
    border:               2px;
    border-color:         @color2;   /* Dynamic Pywal window border */
    border-radius:        24px;      /* Pill-like rounded corners */
    enabled:              true;
    margin:               0px;
    padding:              0px;
}

mainbox {
    background-color:     transparent;
    children:             [listview];
    padding:              15px;
}

listview {
    background-color:     transparent;
    columns:              1;
    lines:                5;
    spacing:              15px;      /* Slightly increased for breathing room between buttons */
    cycle:                true;
    dynamic:              false;
    layout:               vertical;
}

element {
    padding:              15px 10px;
    border-radius:        14px;      /* Rounded inner buttons */
    orientation:          horizontal;
    background-color:     @background-alt-glass;
    text-color:           @foreground;
    border:               2px;
    border-color:         transparent;
}

/* Hovered / Selected Button */
element selected {
    background-color:     @selected-glass;
    border:               2px;
    border-color:         @color4;   /* Pywal Accent pops when hovered */
    text-color:           @color6;   
}

/* Urgent state (e.g., Shutdown/Reboot warning buttons) */
element selected.urgent {
    background-color:     @color1;   /* Pywal Color 1 is usually a red/accent color */
    border-color:         @color1;
    text-color:           @background;
}

element normal.urgent, element alternate.urgent {
    background-color:     @background-alt-glass;
    border-color:         @color1;
    text-color:           @color1;
}

/* Active state */
element selected.active {
    background-color:     @color3;
    border-color:         @color3;
    text-color:           @background;
}

element normal.active, element alternate.active {
    background-color:     @background-alt-glass;
    border-color:         @color3;
    text-color:           @color3;
}

element-text {
    background-color:     transparent;
    text-color:           inherit;
    horizontal-align:     0.5;
    vertical-align:       0.5;
}

/* Hide the search bar entirely for this menu */
inputbar {
    enabled:              false;
}