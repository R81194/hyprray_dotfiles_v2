/* Import Pywal colors generated by your scripts */
@import "~/.cache/wal/colors.rasi"

* {
    /* Glassy Palette */
    background-glass: #00000080; /* 50% transparent dark glass */
    selected-glass:   #ffffff26; /* 15% transparent white */
    
    /* Reset */
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
    background-color: transparent;
}

window {
    width:            51.5%;         
    height:           220px;       /* Increased height so images don't clip and vanish */
    location:         south;       
    anchor:           south;       
    y-offset:         -20px;       
    
    background-color: @background-glass;
    border-radius:    24px;        
    border:           2px;         
    border-color:     @color2;     /* Dynamic Pywal color */
}

mainbox {
    children:         [ listview ];
    padding:          20px;        
}

/* List of Wallpapers */
listview {
    layout:           horizontal;
    spacing:          20px;        
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
}

element {
    orientation:      vertical;
    border-radius:    14px;
    padding:          15px;        
    cursor:           pointer;
    children:         [ element-icon ]; /* THE FIX: Forces Rofi to only render the image container */
}

/* The "Magnified/Pop" Illusion for the selected item */
element selected {
    background-color: @selected-glass;
    border:           5px;         
    border-color:     @color4;     
}

/* The Image Preview */
element-icon {
    size:             140px;       /* Uses the icon size to stretch the box naturally */
    horizontal-align: 0.5;
    vertical-align:   0.5;
    cursor:           pointer;
    expand:           true;
}