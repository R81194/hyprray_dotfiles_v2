/*******************************************************************************
 * ROFI GLASSY WAYBAR SWITCHER (Clean) - Pywal Edition
 *******************************************************************************/

/* Import Pywal colors */
@import "~/.cache/wal/colors.rasi"

configuration {
    show-icons: false;
    drun-display-format: "{name}";
    click-to-exit: true;
}

* {
    font: "JetBrains Mono Nerd Font Propo 11"; 

    /* GLASSY PYWAL PALETTE */
    bg-glass: #000000A6; 
    bg-dark: #000000B3;  
    glass-white:    #ffffff26; 
    glass-selected: #ffffff33; 
    
    fg-col:       @foreground; 
    fg-col-muted: #ffffff99;   
}

window {
    height:           300px;
    width:            380px; /* Slightly narrower since the sidebar is gone */
    border:           3px;
    border-color:     @color2; 
    border-radius:    14px;
    background-color: transparent;
    transparency:     "real";
    location:         center;
}

/* MAINBOX: Simple vertical stack */
mainbox {
    background-color: transparent;
    orientation:      vertical; 
    children:         [ inputbar, listview ];
    spacing:          2px;
}

/* --- SEARCH / PROMPT --- */
inputbar {
    children:         [ prompt, entry ];
    background-color: @bg-glass;
    border-radius:    10px;
    padding:          8px;
    margin:           2px;
}

prompt {
    background-color: @glass-white;
    padding:          4px 10px;
    text-color:       @fg-col;
    border-radius:    6px;
}

entry {
    padding:          4px;
    text-color:       white;
    background-color: transparent;
    placeholder:      "Switch Waybar...";
    placeholder-color:@fg-col-muted;
}

/* --- LIST VIEW --- */
listview {
    background-color: @bg-dark; 
    columns:          1; 
    lines:            5;
    border-radius:    10px;
    padding:          8px;
    spacing:          4px;
    margin:           2px;
}

element {
    padding:          8px;
    background-color: transparent;
    text-color:       @fg-col-muted;
    border-radius:    6px;
}

element selected {
    background-color: @glass-selected;
    text-color:       @fg-col;
    border:           1px;
    border-color:     @color4;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    vertical-align:   0.5;
}