{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 8,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-icon-size": 48,
  "timeout": 10,
  "fit-to-screen": true,
  "control-center-width": 380,
  "notification-window-width": 380,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-length": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  
  "widgets": [
    "title",
    "dnd",
    "mpris",
    "volume",
    "backlight",
    "buttons-grid"
  ],
  
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "󰎟 Clear"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "image-size": 64,
      "image-radius": 12
    },
    "volume": {
      "label": " ",
      "show-per-app": true
    },
    "backlight": {
      "label": "󰃠 "
    },
    "buttons-grid": {
      "actions": [
        { "label": " ", "command": "nmcli radio wifi toggle" },
        { "label": " ", "command": "rfkill toggle bluetooth" },
        { "label": "󰀝 ", "command": "rfkill toggle all" },
        { "label": " ", "command": "pkill hyprsunset || hyprsunset -t 4500" },
        { "label": " ", "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle" },
        { "label": "󰝟 ", "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" },
        { "label": " ", "command": "hyprlock" },
        { "label": "󰓅 ", "command": "pkexec auto-cpufreq --force=performance" },
        { "label": "󰾆 ", "command": "pkexec auto-cpufreq --force=reset" },
        { "label": " ", "command": "pkexec auto-cpufreq --force=powersave" }
      ]
    }
  }
}